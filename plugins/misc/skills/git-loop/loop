#!/usr/bin/env bash
# claude -p を無限に回す。各回は Git 履歴と前回の state.md から次の作業を決める。
set -u

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root"

state_dir="$HOME/.local/state/git-loop/${root//\//%}"
mkdir -p "$state_dir/log"
rm -f "$state_dir/stop"

interval=${GIT_LOOP_INTERVAL:-10}
args=(--permission-mode "${GIT_LOOP_PERMISSION_MODE:-auto}")
[ -n "${GIT_LOOP_MODEL:-}" ] && args+=(--model "$GIT_LOOP_MODEL")

prompt=$(cat <<PROMPT
You are one iteration of an endless loop working on the repository at $root.
Look at the Git history and find the next thing to do, then do it.

1. Read $state_dir/state.md (notes from the previous iteration) and $state_dir/hint.md (standing direction from the human) if they exist. Do not edit hint.md.
2. Read the recent Git history (git log, git show, git status) and decide the single next task. Prefer finishing what the previous iteration left unfinished.
3. Do the task and commit it. Keep each iteration to one small, coherent change.
4. Overwrite $state_dir/state.md with: what you did this iteration, the commit hash, what should come next, and any open questions for the human.
5. If there is nothing meaningful left to do, or you need a human decision, say so in state.md and create the file $state_dir/stop.

Never push, force-push, or rewrite history.
PROMPT
)

while [ ! -e "$state_dir/stop" ]; do
  log="$state_dir/log/$(date +%Y%m%d-%H%M%S).log"
  echo "== $(date '+%F %T') iteration -> $log"
  claude -p "$prompt" "${args[@]}" > "$log" 2>&1
  echo "   exit=$?"
  [ -e "$state_dir/stop" ] && break
  sleep "$interval"
done

echo "stopped: $state_dir/stop"
